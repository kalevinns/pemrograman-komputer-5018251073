      "source": [
        "\n",
        "# Program Sensor Log Analyzer\n",
        "\n",
        "sensor_log = [45, 52, 67, 81, 73, 90, 58, -5, 76, 84, 62, 71, 95, 49, -2, 88, 55, 79, 92, 64]\n",
        "\n",
        "BATAS_ALARM = 80\n",
        "total = 0\n",
        "jumlah_data_valid = 0\n",
        "jumlah_alarm = 0\n",
        "nilai_min = None\n",
        "nilai_maks = None\n",
        "\n",
        "print(\"==SENSOR LOG ANALYZER==\")\n",
        "print(\"Batas ALARM:\", BATAS_ALARM)\n",
        "print()\n",
        "\n",
        "\n",
        "for i in range(len(sensor_log)):\n",
        "    nilai = sensor_log[i]\n",
        "\n",
        "    if nilai < 0:\n",
        "        print(f\"{i + 1:<15}{nilai:<18}DATA TIDAK VALID\")\n",
        "        continue\n",
        "\n",
        "    if nilai >= BATAS_ALARM:\n",
        "        status = \"ALARM\"\n",
        "        jumlah_alarm += 1\n",
        "    else:\n",
        "        status = \"NORMAL\"\n",
        "\n",
        "    print(f\"{i + 1:<15}{nilai:<18}{status}\")\n",
        "\n",
        "    total += nilai\n",
        "    jumlah_data_valid += 1\n",
        "\n",
        "    if nilai_min is None or nilai < nilai_min:\n",
        "        nilai_min = nilai\n",
        "\n",
        "    if nilai_maks is None or nilai > nilai_maks:\n",
        "        nilai_maks = nilai\n",
        "\n",
        "print(\"-\" * 50)\n",
        "print(\"HASIL ANALISIS SENSOR\")\n",
        "\n",
        "if jumlah_data_valid > 0:\n",
        "    rata_rata = total / jumlah_data_valid\n",
        "\n",
        "    print(f\"Jumlah data valid : {jumlah_data_valid}\")\n",
        "    print(f\"Rata-rata sensor  : {rata_rata:.2f}\")\n",
        "    print(f\"Jumlah alarm      : {jumlah_alarm}\")\n",
        "    print(f\"Nilai minimum     : {nilai_min}\")\n",
        "    print(f\"Nilai maksimum    : {nilai_maks}\")\n",
        "else:\n",
        "    print(\"Tidak ada data sensor yang valid.\")\n",
        "\n",
        "print(\"=\" * 50)\n"
      ],
